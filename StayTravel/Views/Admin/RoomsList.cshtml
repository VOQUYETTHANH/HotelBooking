@model IEnumerable<StayTravel.Models.Room>
@{
    ViewBag.Title = "Quản lý Phòng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Quản lý Phòng Khách Sạn</h2>
    <a href="@Url.Action("CreateRoom", "Admin")" class="btn btn-warning fw-bold">
        <i class="fa fa-plus"></i> Thêm Phòng Mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        @using (Html.BeginForm("RoomsList", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-lg-3 col-md-6">
                <label class="form-label fw-semibold">Tìm kiếm</label>
                <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control"
                       placeholder="Tên khách sạn hoặc số phòng..." />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label fw-semibold">Địa điểm</label>
                @Html.DropDownList("locationId", (SelectList)ViewBag.LocationId, "Tất cả địa điểm", new { @class = "form-select" })
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label fw-semibold">Khách sạn</label>
                @Html.DropDownList("hotelId", (SelectList)ViewBag.HotelId, "Tất cả khách sạn", new { @class = "form-select" })
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label fw-semibold">Loại phòng</label>
                @Html.DropDownList("roomTypeId", (SelectList)ViewBag.RoomTypeId, "Tất cả loại phòng", new { @class = "form-select" })
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label fw-semibold">Trạng thái phòng</label>
                <select name="roomStatus" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="available" @(ViewBag.RoomStatus == "available" ? "selected" : "")>Phòng trống</option>
                    <option value="occupied" @(ViewBag.RoomStatus == "occupied" ? "selected" : "")>Đang có khách</option>
                    <option value="approved" @(ViewBag.RoomStatus == "approved" ? "selected" : "")>Đã duyệt, chưa check-in</option>
                </select>
            </div>
            <div class="col-lg-1 col-md-6 d-grid">
                <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Lọc</button>
            </div>
            <div class="col-12">
                <a href="@Url.Action("RoomsList", "Admin")" class="btn btn-outline-secondary btn-sm">Xóa bộ lọc</a>
            </div>
        }
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover bg-white shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Địa điểm</th>
                <th>Khách Sạn</th>
                <th>Số Phòng</th>
                <th>Loại Phòng</th>
                <th>Giá / Đêm</th>
                <th>Trạng Thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var r in Model)
                {
                    var roomHasGuest = r.IsAvailable == false;
                    <tr>
                        <td>#@r.RoomId</td>
                        <td>@(r.Hotel != null && r.Hotel.Location != null ? r.Hotel.Location.LocationName : "—")</td>
                        <td class="fw-bold">@(r.Hotel != null ? r.Hotel.HotelName : "—")</td>
                        <td>@r.RoomNumber</td>
                        <td>@(r.RoomType != null ? r.RoomType.TypeName : "—")</td>
                        <td class="text-danger fw-bold">@string.Format("{0:N0}", r.Price) VNĐ</td>
                        <td>
                            @if (r.IsAvailable == true)
                            {
                                <span class="badge bg-success">Trống / Có thể đặt</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đang được giữ / Không khả dụng</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a href="@Url.Action("EditRoom", "Admin", new { id = r.RoomId })" class="btn btn-sm btn-primary">Sửa</a>
                            <a href="@Url.Action("DeleteRoom", "Admin", new { id = r.RoomId })" class="btn btn-sm btn-danger"
                               onclick="return confirm('Bạn có chắc muốn xóa phòng này?');">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8" class="text-center py-4 text-muted">Không tìm thấy phòng phù hợp.</td></tr>
            }
        </tbody>
    </table>
</div>
