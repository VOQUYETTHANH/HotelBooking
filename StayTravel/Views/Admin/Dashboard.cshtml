@model List<StayTravel.Models.Booking>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard - StayTravel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-light">
    <div class="d-flex">
        <div class="bg-dark text-white p-3 vh-100" style="width: 250px;">
            <h4 class="text-warning fw-bold">Admin Portal</h4>
            <hr />
            <ul class="nav flex-column">

                @{
                    // Lấy tên Action hiện tại để biết đang đứng ở trang nào
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }

                <ul class="nav flex-column">
                    <!-- Tổng quan / Dashboard -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("Dashboard", "Admin")" class="nav-link @(currentAction == "Dashboard" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-chart-line me-2 sidebar-icon"></i> Tổng Quan
                        </a>
                    </li>

                    <!-- Quản lý Đặt phòng -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("BookingsList", "Admin")" class="nav-link @(currentAction == "BookingsList" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-calendar-check me-2 sidebar-icon"></i> Quản Lý Đặt Phòng
                        </a>
                    </li>

                    <!-- Quản lý Khách sạn -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("HotelsList", "Admin")" class="nav-link @(currentAction == "HotelsList" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-hotel me-2 sidebar-icon"></i> Quản Lý Khách Sạn
                        </a>
                    </li>

                    <!-- Quản lý Phòng -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("RoomsList", "Admin")" class="nav-link @(currentAction == "RoomsList" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-door-open me-2 sidebar-icon"></i> Quản Lý Phòng
                        </a>
                    </li>

                    <!-- Quản lý Tài khoản -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("UsersList", "Admin")" class="nav-link @(currentAction == "UsersList" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-users-gear me-2 sidebar-icon"></i> Quản Lý Tài Khoản
                        </a>
                    </li>

                    <hr class="text-secondary my-2">

                     @*Về trang chủ*@ 
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Home")" class="nav-link text-secondary">
                            <i class="fa-solid fa-house me-2 sidebar-icon"></i> Về trang chủ
                        </a>
                    </li>
                </ul>

               
            </ul>
        </div>
        <div class="p-4 flex-grow-1">
            <h2>Tổng Quan Hệ Thống</h2>
            <div class="row my-4">
                <div class="col-md-4">
                    <div class="card bg-primary text-white p-3"><h5>Tổng Khách Sạn</h5><h3>@ViewBag.TotalHotels</h3></div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white p-3"><h5>Tổng Đơn Đặt</h5><h3>@ViewBag.TotalBookings</h3></div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-warning text-dark p-3"><h5>Người Dùng</h5><h3>@ViewBag.TotalUsers</h3></div>
                </div>
            </div>

            <h4>Lịch Sử Đặt Phòng Gần Đây</h4>
            <table class="table table-striped bg-white shadow-sm">
                <thead>
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Khách Sạn</th>
                        <th>Tổng Tiền</th>
                        <th>Thanh Toán</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>#@b.BookingId</td>
                            <td>@b.User.FullName</td>
                            <td>@b.Room.Hotel.HotelName</td>
                            <td>@string.Format("{0:N0}", b.TotalPrice) VNĐ</td>
                            <td>@b.PaymentMethod</td>
                            <td><span class="badge bg-secondary">@b.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>