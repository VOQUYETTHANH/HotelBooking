@{
    ViewBag.Title = "Đăng Nhập - StayTravel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="max-width: 450px;">
    <div class="card border-0 shadow-lg p-4 rounded-4">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-warning"><i class="fa-solid fa-right-to-bracket me-2"></i>Đăng Nhập</h3>
            <p class="text-muted small">Chào mừng bạn quay trở lại với StayTravel</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>@ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">Địa Chỉ Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                    <input type="email" name="email" class="form-control" placeholder="admin@staytravel.com hoặc minh@gmail.com" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mật Khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" />
                    <label class="form-check-label small" for="rememberMe">Ghi nhớ đăng nhập</label>
                </div>
                <a href="#" class="small text-muted text-decoration-none">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-warning w-100 fw-bold py-2 shadow-sm">
                <i class="fa-solid fa-right-to-bracket me-2"></i>Đăng Nhập
            </button>
        }

        <hr class="my-4" />

        <div class="text-center">
            <p class="mb-0">Chưa có tài khoản? <a href="@Url.Action("Register", "Account")" class="text-warning fw-bold text-decoration-none">Tạo tài khoản mới</a></p>
        </div>
    </div>
</div>