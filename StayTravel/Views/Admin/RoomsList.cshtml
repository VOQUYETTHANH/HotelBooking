@model List<StayTravel.Models.Room>
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>Quản lý Phòng - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-light">
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="bg-dark text-white p-3 vh-100" style="width: 250px;">
            <h4 class="text-warning fw-bold">Admin Portal</h4>
            <hr />
            <ul class="nav flex-column">
                <!-- Tổng quan / Dashboard -->
                @{
                    // Lấy tên Action hiện tại để biết đang đứng ở trang nào
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }

                <ul class="nav flex-column">
                    <!-- Tổng quan / Dashboard -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("Dashboard", "Admin")" class="nav-link @(currentAction == "Dashboard" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-chart-line me-2 sidebar-icon"></i> Tổng Quan
                        </a>
                    </li>

                    <!-- Quản lý Đặt phòng -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("BookingsList", "Admin")" class="nav-link @(currentAction == "BookingsList" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-calendar-check me-2 sidebar-icon"></i> Quản Lý Đặt Phòng
                        </a>
                    </li>

                    <!-- Quản lý Khách sạn -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("HotelsList", "Admin")" class="nav-link @(currentAction == "HotelsList" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-hotel me-2 sidebar-icon"></i> Quản Lý Khách Sạn
                        </a>
                    </li>

                    <!-- Quản lý Phòng -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("RoomsList", "Admin")" class="nav-link @(currentAction == "RoomsList" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-door-open me-2 sidebar-icon"></i> Quản Lý Phòng
                        </a>
                    </li>

                    <!-- Quản lý Tài khoản -->
                    <li class="nav-item mb-2">
                        <a href="@Url.Action("UsersList", "Admin")" class="nav-link @(currentAction == "UsersList" ? "text-warning fw-bold" : "text-white")">
                            <i class="fa-solid fa-users-gear me-2 sidebar-icon"></i> Quản Lý Tài Khoản
                        </a>
                    </li>

                    <hr class="text-secondary my-2">

                    <!-- Về trang chủ -->
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Home")" class="nav-link text-secondary">
                            <i class="fa-solid fa-house me-2 sidebar-icon"></i> Về trang chủ
                        </a>
                    </li>
                </ul>
            </ul>
        </div>
        <!-- Main Content -->
        <div class="p-4 flex-grow-1">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Quản lý Phòng Khách Sạn</h2>
                <a href="@Url.Action("CreateRoom", "Admin")" class="btn btn-warning fw-bold"><i class="fa fa-plus"></i> Thêm Phòng Mới</a>
            </div>
            <table class="table table-striped table-hover bg-white shadow-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Khách Sạn</th>
                        <th>Số Phòng</th>
                        <th>Loại Phòng</th>
                        <th>Giá / Đêm</th>
                        <th>Trạng Thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>#@r.RoomId</td>
                            <td class="fw-bold">@r.Hotel.HotelName</td>
                            <td>@r.RoomNumber</td>
                            <td>@r.RoomType.TypeName</td>
                            <td class="text-danger fw-bold">@string.Format("{0:N0}", r.Price) VNĐ</td>
                            <td>
                                @if (r.IsAvailable == true)
                                {
                                    <span class="badge bg-success">Trống (Cho phép đặt)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Đã đặt / Khóa</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("EditRoom", "Admin", new { id = r.RoomId })" class="btn btn-sm btn-primary">Sửa</a>
                                <a href="@Url.Action("DeleteRoom", "Admin", new { id = r.RoomId })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa phòng này?');">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>