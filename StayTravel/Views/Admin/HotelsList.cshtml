@model List<StayTravel.Models.Hotel>
@{
    ViewBag.Title = "Quản lý Khách sạn";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Quản lý Khách sạn</h2>
    <a href="@Url.Action("CreateHotel", "Admin")" class="btn btn-warning fw-bold"><i class="fa fa-plus"></i> Thêm Khách Sạn Mới</a>
</div>
<table class="table table-striped table-hover bg-white shadow-sm align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Hình ảnh</th>
            <th>Tên Khách Sạn</th>
            <th>Địa Điểm</th>
            <th>Địa Chỉ</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>#@h.HotelId</td>
                <td><img src="@h.ImageUrl" width="60" height="40" style="object-fit:cover;" class="rounded" /></td>
                <td class="fw-bold">@h.HotelName</td>
                <td>@h.Location.LocationName</td>
                <td>@h.Address</td>
                <td>
                    <a href="@Url.Action("EditHotel", "Admin", new { id = h.HotelId })" class="btn btn-sm btn-primary">Sửa</a>
                    <a href="@Url.Action("DeleteHotel", "Admin", new { id = h.HotelId })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa khách sạn này?');">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>