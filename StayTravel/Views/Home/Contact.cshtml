@{
    ViewBag.Title = "Liên Hệ - StayTravel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="fw-bold border-start border-warning border-4 ps-3 mb-4">Liên Hệ Với Chúng Tôi</h2>

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@ViewBag.Success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Form Gửi Thông Tin -->
        <div class="col-md-7">
            <div class="card p-4 border-0 shadow-sm">
                <h4 class="fw-bold mb-3">Gửi Thắc Mắc Hoặc Góp Ý</h4>
                @using (Html.BeginForm("Contact", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                            <input type="text" name="fullName" class="form-control" placeholder="Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                            <input type="email" name="email" class="form-control" placeholder="example@gmail.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số Điện Thoại</label>
                            <input type="tel" name="phone" class="form-control" placeholder="0909xxxxxx" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Chủ Đề</label>
                            <input type="text" name="subject" class="form-control" placeholder="Tư vấn đặt phòng / Góp ý..." />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Nội Dung <span class="text-danger">*</span></label>
                            <textarea name="message" class="form-control" rows="5" placeholder="Nhập nội dung chi tiết tại đây..." required></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-warning fw-bold px-4 py-2"><i class="fa-solid fa-paper-plane me-2"></i>Gửi Liên Hệ</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Thông tin Địa chỉ & Bản đồ -->
        <div class="col-md-5">
            <div class="card p-4 border-0 shadow-sm h-100 bg-light">
                <h4 class="fw-bold mb-4">Thông Tin Văn Phòng</h4>
                <div class="mb-3 d-flex align-items-start">
                    <i class="fa-solid fa-location-dot text-warning fa-lg me-3 mt-2"></i>
                    <div>
                        <strong class="d-block">Địa chỉ:</strong>
                        <span class="text-secondary">141 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh</span>
                    </div>
                </div>
                <div class="mb-3 d-flex align-items-start">
                    <i class="fa-solid fa-phone text-warning fa-lg me-3 mt-2"></i>
                    <div>
                        <strong class="d-block">Hotline hỗ trợ:</strong>
                        <span class="text-secondary">1900 123 456 - 0909 123 456</span>
                    </div>
                </div>
                <div class="mb-3 d-flex align-items-start">
                    <i class="fa-solid fa-envelope text-warning fa-lg me-3 mt-2"></i>
                    <div>
                        <strong class="d-block">Email hỗ trợ:</strong>
                        <span class="text-secondary">support@staytravel.com</span>
                    </div>
                </div>
                <div class="mb-3 d-flex align-items-start">
                    <i class="fa-solid fa-clock text-warning fa-lg me-3 mt-2"></i>
                    <div>
                        <strong class="d-block">Giờ làm việc:</strong>
                        <span class="text-secondary">Thứ 2 - Chủ Nhật: 08:00 - 21:00</span>
                    </div>
                </div>

                <!-- Bản đồ Google Maps Demo -->
                <div class="mt-3 rounded overflow-hidden shadow-sm" style="height: 200px;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.4602330353457!2d106.7024843!3d10.7752674!2m3!1f0!1f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f41639f7d0b%3A0xe5497210e1948332!2zMTQxIE5ndXnhu4VuIEh14buHLCBC4bq_biBOZ2jDqSwgUXXhuq1uIDEsIFRow6BuaCBwaOG7kSBI4buTIENow60gTWluaA!5e0!3m2!1svi!2svn!4v1700000000000!5m2!1svi!2svn"
                            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>