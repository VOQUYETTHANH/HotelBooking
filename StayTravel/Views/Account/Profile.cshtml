@model StayTravel.Models.UserProfileViewModel
@{
    ViewBag.Title = "Thông Tin Tài Khoản - StayTravel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Thẻ hiển thị Avatar & Thông tin nhanh -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.User.Avatar) ? "/Images/default-avatar.png" : Model.User.Avatar)"
                         class="rounded-circle border border-warning border-3 object-fit-cover shadow-sm"
                         width="130" height="130" alt="Avatar" />
                </div>
                <h4 class="fw-bold mb-1">@Model.User.FullName</h4>
                <p class="text-muted small mb-2"><i class="fa-solid fa-envelope me-1"></i>@Model.User.Email</p>
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill w-auto mx-auto mb-3">
                    <i class="fa-solid fa-shield me-1"></i>@(Model.User.RoleId == 1 ? "Quản trị viên" : "Khách hàng")
                </span>
                <hr />
                <div class="text-start text-secondary small">
                    <p class="mb-2"><i class="fa-solid fa-phone me-2 text-warning"></i><strong>SĐT:</strong> @(string.IsNullOrEmpty(Model.User.PhoneNumber) ? "Chưa cập nhật" : Model.User.PhoneNumber)</p>
                    <p class="mb-0"><i class="fa-solid fa-calendar-day me-2 text-warning"></i><strong>Ngày tham gia:</strong> @(Model.User.CreatedAt.HasValue ? Model.User.CreatedAt.Value.ToString("dd/MM/yyyy") : "N/A")</p>
                </div>
            </div>
        </div>

        <!-- Cột phải: Các Tabs (Cập nhật thông tin / Lịch sử / Yêu thích) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <ul class="nav nav-tabs card-header-tabs border-bottom-0" id="profileTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold px-3 py-2" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button">
                                <i class="fa-solid fa-user-pen me-2"></i>Thông Tin Cá Nhân
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold px-3 py-2" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button">
                                <i class="fa-solid fa-clock-rotate-left me-2"></i>Lịch Sử Đặt Phòng
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold px-3 py-2" id="wishlist-tab" data-bs-toggle="tab" data-bs-target="#wishlist" type="button">
                                <i class="fa-solid fa-heart text-danger me-2"></i>Yêu Thích
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4">
                    <div class="tab-content" id="profileTabsContent">

                        <!-- TAB 1: FORM CẬP NHẬT THÔNG TIN -->
                        <div class="tab-pane fade show active" id="info" role="tabpanel">
                            <h5 class="fw-bold mb-4 text-warning"><i class="fa-solid fa-sliders me-2"></i>Chỉnh Sửa Hồ Sơ</h5>

                            @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Email (Tài khoản)</label>
                                        <input type="email" class="form-control bg-light" value="@Model.User.Email" readonly disabled />
                                        <small class="text-muted">Email không thể thay đổi</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                                        <input type="text" name="fullName" class="form-control" value="@Model.User.FullName" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Số Điện Thoại</label>
                                        <input type="tel" name="phoneNumber" class="form-control" value="@Model.User.PhoneNumber" placeholder="Nhập số điện thoại..." />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Thay Đổi Avatar</label>
                                        <input type="file" name="avatarFile" class="form-control" accept="image/*" />
                                    </div>
                                    <div class="col-12 mt-4">
                                        <button type="submit" class="btn btn-warning fw-bold px-4 py-2 shadow-sm">
                                            <i class="fa-solid fa-floppy-disk me-2"></i>Lưu Thay Đổi
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- TAB 2: LỊCH SỬ ĐẶT PHÒNG -->
                        <div class="tab-pane fade" id="history" role="tabpanel">
                            <h5 class="fw-bold mb-4 text-warning"><i class="fa-solid fa-list-check me-2"></i>Danh Sách Giao Dịch</h5>
                            @if (Model.BookingHistory == null || !Model.BookingHistory.Any())
                            {
                                <div class="alert alert-light text-center py-4 border">
                                    <i class="fa-solid fa-box-open fa-2x text-muted mb-2"></i>
                                    <p class="mb-0 text-muted">Bạn chưa thực hiện đơn đặt phòng nào.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Khách Sạn</th>
                                                <th>Số Phòng</th>
                                                <th>Ngày Nhận / Trả</th>
                                                <th>Tổng Tiền</th>
                                                <th>Trạng Thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.BookingHistory)
                                            {
                                                <tr>
                                                    <td><strong>@(item.Room?.Hotel?.HotelName ?? "N/A")</strong></td>
                                                    <td>Phòng @(item.Room?.RoomNumber ?? "N/A")</td>
                                                    <td>
                                                        <small class="d-block text-success"><i class="fa-solid fa-calendar-check me-1"></i>In: @item.CheckInDate.ToString("dd/MM/yyyy")</small>
                                                        <small class="d-block text-danger"><i class="fa-solid fa-calendar-xmark me-1"></i>Out: @item.CheckOutDate.ToString("dd/MM/yyyy")</small>
                                                    </td>
                                                    <td class="text-danger fw-bold">@string.Format("{0:N0}", item.TotalPrice) VNĐ</td>
                                                    <td><span class="badge bg-warning text-dark">@item.Status</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <!-- TAB 3: DANH MỤC YÊU THÍCH -->
                        <div class="tab-pane fade" id="wishlist" role="tabpanel">
                            <h5 class="fw-bold mb-4 text-warning"><i class="fa-solid fa-heart me-2 text-danger"></i>Khách Sạn Đã Lưu</h5>
                            @if (Model.Wishlists == null || !Model.Wishlists.Any())
                            {
                                <div class="alert alert-light text-center py-4 border">
                                    <i class="fa-solid fa-heart-crack fa-2x text-muted mb-2"></i>
                                    <p class="mb-0 text-muted">Danh sách yêu thích của bạn đang trống.</p>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var fav in Model.Wishlists)
                                    {
                                        if (fav.Hotel != null)
                                        {
                                            <div class="col-md-6">
                                                <div class="card h-100 border-0 shadow-sm">
                                                    <img src="@fav.Hotel.ImageUrl" class="card-img-top" height="130" style="object-fit:cover;" />
                                                    <div class="card-body p-3">
                                                        <h6 class="fw-bold mb-1">@fav.Hotel.HotelName</h6>
                                                        <p class="small text-muted mb-2"><i class="fa-solid fa-location-dot me-1"></i>@fav.Hotel.Address</p>
                                                        <a href="@Url.Action("Details", "Hotels", new { id = fav.HotelId })" class="btn btn-outline-dark btn-sm w-100">Xem Chi Tiết</a>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>