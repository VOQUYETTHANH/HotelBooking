@model StayTravel.Models.User
@{
    ViewBag.Title = "Đăng Ký Tài Khoản - StayTravel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="max-width: 500px;">
    <div class="card border-0 shadow-lg p-4 rounded-4">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-warning"><i class="fa-solid fa-user-plus me-2"></i>Đăng Ký Thành Viên</h3>
            <p class="text-muted small">Tạo tài khoản ngay để nhận ưu đãi đặt phòng tốt nhất</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>@ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", @placeholder = "Nguyễn Văn Minh", @required = "required" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email (Tài khoản) <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "email", @placeholder = "name@example.com", @required = "required" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mật Khẩu <span class="text-danger">*</span></label>
                @Html.PasswordFor(m => m.PasswordHash, new { @class = "form-control", @placeholder = "••••••••", @required = "required" })
                @Html.ValidationMessageFor(m => m.PasswordHash, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Số Điện Thoại</label>
                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", @placeholder = "0988765432" })
                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
            </div>

            <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mt-2 shadow-sm">
                <i class="fa-solid fa-user-check me-2"></i>Đăng Ký Ngay
            </button>
        }

        <hr class="my-4" />

        <div class="text-center">
            <p class="mb-0">Đã có tài khoản? <a href="@Url.Action("Login", "Account")" class="text-warning fw-bold text-decoration-none">Đăng nhập tại đây</a></p>
        </div>
    </div>
</div>